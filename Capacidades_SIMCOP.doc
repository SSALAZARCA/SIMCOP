    <meta charset="utf-8">
    <title>Capacidades y Valor Operacional - SIMCOP</title>
    <style>
        body { font-family: 'Calibri', sans-serif; line-height: 1.6; color: #333; }
        h1 { color: #0f172a; text-align: center; border-bottom: 3px solid #0f172a; padding-bottom: 10px; font-size: 2.2em; text-transform: uppercase; }
        h2 { color: #ffffff; background-color: #1e3a8a; padding: 12px 15px; margin-top: 35px; font-size: 1.4em; border-radius: 4px; border-left: 8px solid #93c5fd; }
        h3 { color: #1e40af; margin-top: 20px; font-size: 1.2em; border-bottom: 2px solid #e2e8f0; padding-bottom: 5px; }
        p { text-align: justify; margin-bottom: 10px; }
        ul { margin-bottom: 15px; padding-left: 20px; }
        li { margin-bottom: 8px; text-align: justify; }
